# 서버 사이드에서만 사용되는 오피넷 API 키
OPINET_API_KEY=F260723461

# 클라이언트에서 사용하는 카카오맵 키 (developers.kakao.com에서 발급)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 클라이언트에서 사용하는 네이버지도 Client ID (NCP 콘솔 > AI·NAVER API > Maps에서 발급)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 클라이언트에서 사용하는 티맵 앱 API 키 (openapi.sk.com 콘솔에서 발급)
NEXT_PUBLIC_TMAP_APP_KEY=

# 서버 사이드에서만 사용되는 Supabase 프로젝트 URL/service role key
# (계정·즐겨찾기·동기화 설정 저장용 순수 Postgres — Supabase Auth 기능은 쓰지 않음)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# next-auth(로그인) 시크릿 - openssl rand -base64 32 등으로 생성
NEXTAUTH_SECRET=

# 카카오 로그인용 OAuth 앱 (developers.kakao.com 콘솔 - 지도 SDK 키와는 별개로 새로 생성)
# 콜백 URL: <배포 도메인>/api/auth/callback/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 로그인용 OAuth 앱 (developers.naver.com 콘솔 - 지도 SDK 키와는 별개로 새로 생성)
# 콜백 URL: <배포 도메인>/api/auth/callback/naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 구글 로그인용 OAuth 앱 (Google Cloud 콘솔)
# 콜백 URL: <배포 도메인>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
